{
  "workflowApiVersion": "1.1",
  "metaData": {
    "icon": "icon.png",
    "category": "custom"
  },
  "type": "REST",
  "lang": {
    "en-US": {
      "name": "ca-teste",
      "description": "Prova de conceito: tela no GitHub Pages e execute em dominio externo."
    }
  },
  "arguments": {
    "execute": {
      "inArguments": [
        { "contactKey": "{{Contact.Key}}" },
        { "origem": "code-resource-teste" }
      ],
      "outArguments": [],
      "url": "https://httpbin.org/anything/execute",
      "verb": "POST",
      "format": "json",
      "useJwt": true,
      "timeout": 10000,
      "retryCount": 0,
      "retryDelay": 1000,
      "concurrentRequests": 1
    }
  },
  "configurationArguments": {
    "applicationExtensionKey": "fb722101-a293-43b7-b4d1-b503f125e75e",
    "save":     { "url": "https://httpbin.org/anything/save",     "verb": "POST", "useJwt": true },
    "publish":  { "url": "https://httpbin.org/anything/publish",  "verb": "POST", "useJwt": true },
    "validate": { "url": "https://httpbin.org/anything/validate", "verb": "POST", "useJwt": true },
    "stop":     { "url": "https://httpbin.org/anything/stop",     "verb": "POST", "useJwt": true }
  },
  "wizardSteps": [
    { "label": "Configurar", "key": "step1" }
  ],
  "userInterfaces": {
    "configModal": {
      "height": 420,
      "width": 640,
      "fullscreen": false
    }
  },
  "schema": {
    "arguments": {
      "execute": {
        "inArguments": [
          { "contactKey": { "dataType": "Text", "isNullable": false, "direction": "in" } },
          { "origem":     { "dataType": "Text", "isNullable": true,  "direction": "in" } }
        ],
        "outArguments": []
      }
    }
  }
}
